+def extract_hybrid_contour_matches(ink0, ink1, n_pts_per_comp=32):
+    """
+    Trích xuất điểm neo dọc theo đường bao nét vẽ Line Art (Contour Matching).
+    Đặc biệt tối ưu cho hoạt họa nét trơn, hình học, vẽ tay khi SIFT không bắt được điểm góc.
+    """
+    if cv2 is None:
+        return np.zeros((0, 2), dtype=np.float32), np.zeros((0, 2), dtype=np.float32)
+    h, w = ink0.shape
+
+    def _extract(ink):
+        mask = (ink > 0.15).astype(np.uint8) * 255
+        cnts, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
+        feats = []
+        for c in cnts:
+            peri = cv2.arcLength(c, True)
+            if peri < 15.0:
+                continue
+            pts_raw = c.reshape(-1, 2).astype(np.float64)
+            diffs = np.diff(np.vstack([pts_raw, pts_raw[0]]), axis=0)
+            seglen = np.linalg.norm(diffs, axis=1)
+            cum = np.concatenate([[0.0], np.cumsum(seglen)])
+            if cum[-1] < 1e-3:
+                continue
+            targets = np.linspace(0.0, cum[-1], n_pts_per_comp, endpoint=False)
+            pts = np.zeros((n_pts_per_comp, 2), dtype=np.float64)
+            for k, d in enumerate(targets):
+                idx = min(np.searchsorted(cum, d, side="right") - 1, len(pts_raw) - 1)
+                alpha = (d - cum[idx]) / max(seglen[idx], 1e-6)
+                pts[k] = (1.0 - alpha) * pts_raw[idx] + alpha * pts_raw[(idx + 1) % len(pts_raw)]
+            cx_m, cy_m = pts.mean(axis=0)
+            ang = np.arctan2(pts[:, 1] - cy_m, pts[:, 0] - cx_m)
+            pts = np.roll(pts, -int(np.argmin(np.abs(ang))), axis=0)
+            area_s = 0.5 * np.sum(pts[:, 0] * np.roll(pts[:, 1], -1) - np.roll(pts[:, 0], -1) * pts[:, 1])
+            if area_s < 0:
+                pts = np.vstack([pts[0:1], pts[1:][::-1]])
+            pts[:, 0] /= max(1.0, w - 1.0)
+            pts[:, 1] /= max(1.0, h - 1.0)
+            _, _, bw, bh = cv2.boundingRect(c)
+            feats.append({
+                'pts': pts.astype(np.float32),
+                'cx': cx_m / max(1.0, w),
+                'cy': cy_m / max(1.0, h),
+                'aspect': bw / max(1.0, float(bh)),
+                'peri': peri
+            })
+        return feats
+
+    f0, f1 = _extract(ink0), _extract(ink1)
+    if not f0 or not f1:
+        return np.zeros((0, 2), dtype=np.float32), np.zeros((0, 2), dtype=np.float32)
+
+    k0_list, k1_list = [], []
+    used1 = set()
+    for item0 in f0:
+        best_j, best_cost = -1, 1e9
+        for j, item1 in enumerate(f1):
+            if j in used1:
+                continue
+            d_pos = np.hypot(item0['cx'] - item1['cx'], item0['cy'] - item1['cy'])
+            d_asp = abs(item0['aspect'] - item1['aspect']) / max(0.1, item0['aspect'] + item1['aspect'])
+            cost = d_pos * 2.0 + d_asp * 0.5
+            if cost < best_cost:
+                best_cost, best_j = cost, j
+        if best_j >= 0 and best_cost < 1.8:
+            used1.add(best_j)
+            k0_list.append(item0['pts'])
+            k1_list.append(f1[best_j]['pts'])
+
+    if not k0_list:
+        return np.zeros((0, 2), dtype=np.float32), np.zeros((0, 2), dtype=np.float32)
+
+    k0_all = np.vstack(k0_list)
+    k1_all = np.vstack(k1_list)
+    return k0_all.astype(np.float32), k1_all.astype(np.float32)
+
